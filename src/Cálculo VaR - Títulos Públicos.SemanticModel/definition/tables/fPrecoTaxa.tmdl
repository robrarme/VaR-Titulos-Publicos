		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"f","Entity":"fPrecoTaxa"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"VariaçãoDiária"}}],"BinItem":{"Expression":{"Member":{"Expression":{"Discretize":{"Expression":{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"VariaçãoDiária"}},"Count":100}},"Member":"Min"}}}}

