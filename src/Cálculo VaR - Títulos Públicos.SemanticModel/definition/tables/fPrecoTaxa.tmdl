	column 'Título Público'
		dataType: string
		lineageTag: f328eded-81e1-43c2-b2a6-78df3d44e643
		summarizeBy: none
		sourceColumn: Título Público

		annotation SummarizationSetBy = Automatic

	column 'Data Anterior' =
			
			VAR DataLinhaAtual = fPrecoTaxa[Data Base]
			VAR TituloPublico = fPrecoTaxa[Título Público]
			RETURN
			    CALCULATE(
			        MAX(fPrecoTaxa[Data Base]),
			        ALL(fPrecoTaxa),
			        fPrecoTaxa[Data Base] < DataLinhaAtual,
			        fPrecoTaxa[Título Público] = TituloPublico
			    )
		formatString: Short Date
		lineageTag: 7c0ab726-23a2-45dd-aa76-45c45e502ea9
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 3875bfc3-43f3-4ad4-a38f-13565fb19bfd
			defaultHierarchy: LocalDateTable_41fffc15-2c39-40c1-a061-46fd39d4b3d0.'Hierarquia de datas'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column VariaçãoDiária = ```
			
			VAR TituloPublico = [Título Público]
			VAR DataLinhaAtual = [Data Base]
			VAR PUBase = [PU Base Manha]
			
			-- 1. Descobre a última data de negociação anterior deste título
			VAR DataAnterior = 
			    CALCULATE(
			        MAX(fPrecoTaxa[Data Base]),
			        REMOVEFILTERS(fPrecoTaxa),
			        fPrecoTaxa[Data Base] < DataLinhaAtual,
			        fPrecoTaxa[Título Público] = TituloPublico
			    )
			
			RETURN
			-- 2. Busca o PU dessa data. Se houver mais de um PU no dia, o MAX desempata e evita o erro.
			IFERROR(LN(PUBase/CALCULATE(
			    MAX(fPrecoTaxa[PU Base Manha]),
			    REMOVEFILTERS(fPrecoTaxa),
			    fPrecoTaxa[Data Base] = DataAnterior,
			    fPrecoTaxa[Título Público] = TituloPublico)),BLANK())
			
			```
		formatString: 0.000%;-0.000%;0.000%
		lineageTag: 6b789b05-360a-4e77-b68d-77a284cd93db
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"fPrecoTaxa","TableItemName":"VariaçãoDiária (compartimentos)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column IDTituloPublico
		dataType: int64
		formatString: 0
		lineageTag: b55e73f8-5a7a-46c3-ba96-65d00681b6b0
		summarizeBy: none
		sourceColumn: IDTituloPublico

		annotation SummarizationSetBy = Automatic

	column 'VariaçãoDiária (compartimentos)' = ```
			VAR __Count = 100
			
			VAR __Min = MIN('fPrecoTaxa'[VariaçãoDiária])
			
			VAR __Max = MAX('fPrecoTaxa'[VariaçãoDiária])
			
			VAR __Difference = (__Max - __Min)
			
			VAR __Size = IF(__Difference > 0, __Difference / __Count, 1)
			
			VAR __BinNumber = 
				IF(
					ISBLANK('fPrecoTaxa'[VariaçãoDiária]),
					BLANK(),
					ROUNDDOWN(('fPrecoTaxa'[VariaçãoDiária] - __Min) / __Size, 0)
				)
			
			RETURN
				IF(
					ISBLANK('fPrecoTaxa'[VariaçãoDiária]),
					BLANK(),
					__Min + (MIN(__BinNumber, __Count - 1) * __Size)
				)
			```
		formatString: 0.000%;-0.000%;0.000%
		lineageTag: c29f75f3-c9a9-4303-8707-bd5c8ba534db
		summarizeBy: none

