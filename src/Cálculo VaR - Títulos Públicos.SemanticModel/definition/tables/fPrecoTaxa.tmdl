table fPrecoTaxa
	lineageTag: 752c6d1f-ff65-456c-aa04-3b25b2853828

	measure Media_Histograma = ```
			AVERAGE(fPrecoTaxa[VariaçãoDiária])
			
			```
		lineageTag: 00995f84-4ff3-4441-85a3-fd225227b1d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Desvio_Padrao = STDEV.P(fPrecoTaxa[VariaçãoDiária])
		lineageTag: 71c5ead8-4dfb-4f52-b54c-eeafe65d1de7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Linha_VaR_95 = [Media_Histograma] - (NORM.S.INV('IntervaloConfiança'[ValorIntervaloConfiança]) * [Desvio_Padrao])
		lineageTag: 0a2b5824-3449-45c8-9ee2-61c815262b66

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Linha_VaR_95_Historico = ```
			PERCENTILE.INC(fPrecoTaxa[VariaçãoDiária], 1-'IntervaloConfiança'[ValorIntervaloConfiança])
			
			```
		lineageTag: 3f1a2e50-bb28-4ce4-8765-55af72eac19e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

